GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_JUDGE_MODEL=gemini-3.5-flash
GEMINI_ENABLE_SEARCH=true
GEMINI_VEO_MODEL=veo-3.1-generate-preview
GEMINI_VEO_PERSON_GENERATION=allow_all
GEMINI_VEO_GENERATE_AUDIO=false

GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore

# Meme slideshow pipeline (free tier — no additional API keys needed)
GEMINI_MEME_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_IMAGE_REVIEW_MODEL=gemini-3.5-flash
